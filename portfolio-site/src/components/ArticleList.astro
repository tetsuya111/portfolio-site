---
// 記事の一覧（日付・タイトル・説明・タグ）。手で書いた記事（/articles/）と自動作成の記事（/it-news/・/security-news/）で共用する。
import TagList from "./TagList.astro";
import { formatDisplayDate } from "../lib/content-query";

interface Props {
  articles: { id: string; data: { title: string; date: Date; tags: string[]; description?: string } }[];
  /** 記事ページの URL の基準（例 /articles/）。記事のリンクは <basePath><id>/ */
  basePath: "/articles/" | "/it-news/" | "/security-news/";
  /** 記事タイトルの見出しの階層。一覧ページでは h2、トップページのセクションの中では h3 */
  headingLevel?: "h2" | "h3";
}

const { articles, basePath, headingLevel: Heading = "h2" } = Astro.props;
---

{
  articles.length === 0 ? (
    <p class="text-muted">まだありません。</p>
  ) : (
    <ul class="space-y-5">
      {articles.map((a) => (
      <li class="rounded-card border border-line bg-surface p-5 shadow-sm">
        <time class="text-sm text-muted tabular-nums" datetime={a.data.date.toISOString()}>
          {formatDisplayDate(a.data.date)}
        </time>
        <Heading class="mt-1 font-heading text-lg font-bold">
          <a href={`${basePath}${a.id}/`} class="hover:text-link hover:underline">
            {a.data.title}
          </a>
        </Heading>
        {a.data.description && <p class="mt-1 text-muted">{a.data.description}</p>}
        <div class="mt-3">
          <TagList tags={a.data.tags} />
        </div>
      </li>
      ))}
    </ul>
  )
}
