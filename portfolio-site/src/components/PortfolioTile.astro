---
// タイル全体をクリック可能にしつつ、URL ボタンを入れ子の <a> にしないため
// タイトルのリンクを疑似要素でタイル全体に広げる（stretched link）。
// 情報の強弱: タイトル（大・太字）＞ URL ボタン（アクセントの塗り）＞ タグ（小・淡色）
import TagList from "./TagList.astro";

interface Props {
  slug: string;
  title: string;
  tags: string[];
  url?: string | undefined;
}

const { slug, title, tags, url } = Astro.props;
---

<article
  class="relative flex flex-col gap-3 rounded-card border border-t-4 border-line border-t-accent bg-surface p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg focus-within:ring-3 focus-within:ring-focus motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
  <h3 class="font-heading text-lg leading-snug font-bold">
    <a href={`/portfolios/${slug}/`} class="after:absolute after:inset-0 focus:outline-none">{title}</a>
  </h3>
  <TagList tags={tags} />
  {
    url && (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-accent relative z-10 mt-auto self-start px-3.5 py-1 text-sm"
      >
        {/* 読み上げ名は見える文字を含める（WCAG 2.5.3）。どのポートフォリオか・別タブで開くことは読み上げ用に補う */}
        ポートフォリオのURL ↗<span class="sr-only">（{title}、新しいタブで開く）</span>
      </a>
    )
  }
</article>
