---
// 英大文字の小見出し（eyebrow）＋日本語の見出し。
// 小見出しは飾りとして読み上げず、見出しのアクセシブルな名前は title だけにする。
interface Props {
  eyebrow: string;
  title: string;
  as?: "h1" | "h2";
  class?: string;
}

const { eyebrow, title, as: Tag = "h2", class: className } = Astro.props;
const size = Tag === "h1" ? "text-3xl sm:text-4xl" : "text-2xl";
---

<div class:list={["flex flex-col gap-1", className]}>
  <p aria-hidden="true" class="font-eyebrow text-xs font-bold tracking-[0.2em] text-link uppercase">{eyebrow}</p>
  <Tag class:list={["font-heading font-bold tracking-tight", size]}>{title}</Tag>
</div>
