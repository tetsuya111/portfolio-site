---
interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
const links = [
  { href: "/", label: "ホーム" },
  { href: "/about/", label: "自己紹介" },
  { href: "/portfolios/", label: "ポートフォリオ" },
  { href: "/articles/", label: "記事" },
];
---

<header class="border-b border-line bg-surface">
  <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4">
    <a href="/" class="flex items-center gap-2 font-heading text-lg font-bold tracking-tight">
      {/* 飾りの印。リンク名はサイト名のみにするため読み上げない */}
      <span aria-hidden="true" class="inline-block size-6 rounded-md bg-accent"></span>{siteName}
    </a>
    <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm font-medium">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="hover:text-link hover:underline">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
