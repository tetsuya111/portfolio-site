---
// 記事ページの本体（戻りリンク・見出し・日付・タグ・本文）。手で書いた記事と自動作成の記事で共用する。
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import TagList from "./TagList.astro";
import { formatDisplayDate } from "../lib/content-query";

interface Props {
  entry: CollectionEntry<"articles"> | CollectionEntry<"itArticles">;
  backHref: string;
  backLabel: string;
}

const { entry, backHref, backLabel } = Astro.props;
const { Content } = await render(entry);
---

<a href={backHref} class="text-sm font-semibold text-link hover:underline">{backLabel}</a>
<header class="mt-6 border-b border-line pb-6">
  <h1 class="font-heading text-3xl font-bold tracking-tight break-words sm:text-4xl">{entry.data.title}</h1>
  <time class="mt-3 block text-sm text-muted tabular-nums" datetime={entry.data.date.toISOString()}>
    {formatDisplayDate(entry.data.date)}
  </time>
  <div class="mt-3"><TagList tags={entry.data.tags} /></div>
</header>
<article class="prose prose-themed mt-8 max-w-none">
  <Content />
</article>
