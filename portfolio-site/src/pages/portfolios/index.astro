---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfolioTile from "../../components/PortfolioTile.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { sortPortfolios } from "../../lib/content-query";

const portfolios = sortPortfolios(await getCollection("portfolios"));
---

<BaseLayout title="ポートフォリオ">
  <SectionHeading as="h1" eyebrow="Works" title="ポートフォリオ" class="mb-8" />
  {
    portfolios.length === 0 ? (
      <p class="text-muted">まだありません。</p>
    ) : (
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {portfolios.map((p) => (
          <PortfolioTile slug={p.id} title={p.data.title} tags={p.data.tags} url={p.data.url} />
        ))}
      </div>
    )
  }
</BaseLayout>
