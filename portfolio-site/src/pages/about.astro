---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const profile = await getEntry("profile", "profile");
if (!profile) throw new Error("src/content/profile/profile.md がありません");
const { Content } = await render(profile);
---

<BaseLayout title="自己紹介" description={profile.data.summary}>
  <h1 class="text-3xl font-bold">{profile.data.name}</h1>
  <p class="mt-1 text-lg text-slate-600">{profile.data.role}</p>
  {
    profile.data.links && profile.data.links.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-4 text-sm">
        {profile.data.links.map((l) => (
          <li>
            <a href={l.url} target="_blank" rel="noopener noreferrer" class="text-sky-700 hover:underline">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <div class="prose prose-slate mt-8 max-w-none">
    <Content />
  </div>
</BaseLayout>
