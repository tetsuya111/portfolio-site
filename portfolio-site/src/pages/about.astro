---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";

const profile = await getEntry("profile", "profile");
if (!profile) throw new Error("src/content/profile/profile.md がありません");
const { Content } = await render(profile);
---

<BaseLayout title="自己紹介" description={profile.data.summary}>
  <header class="rounded-card bg-linear-to-br from-hero-from to-hero-to px-6 py-10 sm:px-10">
    <Eyebrow>Profile</Eyebrow>
    <h1 class="mt-2 font-heading text-3xl font-bold tracking-tight break-words sm:text-4xl">{profile.data.name}</h1>
    <p class="mt-2 text-lg font-medium text-muted">{profile.data.role}</p>
    {
      profile.data.links && profile.data.links.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">
          {profile.data.links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-link hover:underline">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </header>
  <div class="prose prose-themed mt-10 max-w-none">
    <Content />
  </div>
</BaseLayout>
