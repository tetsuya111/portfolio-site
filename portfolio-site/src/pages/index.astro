---
// トップページ。冒頭（氏名・得意分野・相談ボタン）→ サービス → こんな方とお話ししたい → ポートフォリオ → スキル → 最新の記事 → IT ニュースの順に並べる
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PortfolioTile from "../components/PortfolioTile.astro";
import ServiceTile from "../components/ServiceTile.astro";
import SkillTile from "../components/SkillTile.astro";
import AudienceTile from "../components/AudienceTile.astro";
import ConsultCta from "../components/ConsultCta.astro";
import ArticleList from "../components/ArticleList.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PortfolioMockNote from "../components/PortfolioMockNote.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { siteConfig } from "../site.config";
import { publishedArticles, sortByOrder, sortPortfolios } from "../lib/content-query";
import { resolveConsultation } from "../lib/consultation";

const profile = await getEntry("profile", "profile");
if (!profile) throw new Error("src/content/profile/profile.md がありません");
const services = sortByOrder(await getCollection("services"));
const skills = sortByOrder(await getCollection("skills"));
const audiences = sortByOrder(await getCollection("audiences"));
const specialties = skills.slice(0, 6).map((s) => s.data.name);
const portfolios = sortPortfolios(await getCollection("portfolios")).slice(0, 6);
const latestArticles = publishedArticles(await getCollection("articles")).slice(0, 3);
const latestItArticles = publishedArticles(await getCollection("itArticles")).slice(0, 3);
// 宛先・遷移先はビルド時の環境変数で決める（未設定・不正ならフォームを出さない／モックの URL を使う）
const consultation = resolveConsultation(
  { contactEmail: import.meta.env.PUBLIC_CONTACT_EMAIL, taskBoxUrl: import.meta.env.PUBLIC_TASK_BOX_URL },
  siteConfig,
);
const moreLink = "mt-6 inline-block text-sm font-semibold text-link hover:underline";
const grid = "grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3";
---

<BaseLayout title={siteConfig.name} description={profile.data.summary}>
  <section class="mb-16 rounded-card bg-linear-to-br from-hero-from to-hero-to px-6 py-10 sm:px-10 sm:py-12">
    <Eyebrow>Hello</Eyebrow>
    <h1 class="mt-3 font-heading text-4xl leading-tight font-bold tracking-tight break-words sm:text-5xl">
      {profile.data.name}
    </h1>
    <p class="mt-3 text-lg font-medium text-muted">{profile.data.role}</p>
    {profile.data.summary && <p class="mt-4 max-w-2xl leading-relaxed">{profile.data.summary}</p>}
    {
      specialties.length > 0 && (
        <div class="mt-5 flex flex-wrap items-center gap-2">
          <p class="text-sm font-semibold text-muted">得意分野</p>
          <ul aria-label="得意分野" class="flex flex-wrap gap-2">
            {specialties.map((name) => (
              <li class="rounded-full border border-line bg-surface px-3 py-1 text-sm font-semibold">{name}</li>
            ))}
          </ul>
        </div>
      )
    }
    <ConsultCta consultation={consultation} />
    <a href="/about/" class={moreLink}>経歴・自己紹介を見る →</a>
  </section>

  {
    // サービス・スキルの md がないときはセクションごと出さない
    services.length > 0 && (
      <section class="mb-16">
        <SectionHeading eyebrow="Services" title="サービス" class="mb-6" />
        <div class={grid}>
          {services.map((s) => (
            <ServiceTile title={s.data.title} description={s.data.description} />
          ))}
        </div>
        <p class="mt-4 text-sm text-muted">※このサービスは一例です。相談していただければなんでも対応します。</p>
      </section>
    )
  }

  {
    audiences.length > 0 && (
      <section class="mb-16">
        <SectionHeading eyebrow="For You" title="こんな方とお話ししたい" class="mb-6" />
        {/* 1件の文が短いため、3列ではなく2列で並べる（初期の4件が2行にそろう） */}
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          {audiences.map((a) => (
            <AudienceTile title={a.data.title} description={a.data.description} />
          ))}
        </div>
      </section>
    )
  }

  <section class="mb-16">
    <SectionHeading eyebrow="Works" title="ポートフォリオ" class="mb-2" />
    <PortfolioMockNote class="mb-6" />
    {
      portfolios.length === 0 ? (
        <p class="text-muted">まだありません。</p>
      ) : (
        <div class={grid}>
          {portfolios.map((p) => (
            <PortfolioTile
              slug={p.id}
              title={p.data.title}
              description={p.data.description}
              tags={p.data.tags}
              url={p.data.url}
            />
          ))}
        </div>
      )
    }
    <a href="/portfolios/" class={moreLink}>ポートフォリオ一覧へ →</a>
  </section>

  {
    skills.length > 0 && (
      <section class="mb-16">
        <SectionHeading eyebrow="Skills" title="スキル" class="mb-6" />
        <div class={grid}>
          {skills.map((s) => (
            <SkillTile
              id={s.id}
              name={s.data.name}
              category={s.data.category}
              description={s.data.description}
              examples={s.data.examples}
              famous={s.data.famous}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="mb-16">
    <SectionHeading eyebrow="Articles" title="最新の記事" class="mb-6" />
    <ArticleList articles={latestArticles} basePath="/articles/" headingLevel="h3" />
    <a href="/articles/" class={moreLink}>記事一覧へ →</a>
  </section>

  <section>
    <SectionHeading eyebrow="IT News" title="IT ニュース" class="mb-6" />
    <ArticleList articles={latestItArticles} basePath="/it-news/" headingLevel="h3" />
    <a href="/it-news/" class={moreLink}>IT ニュース一覧へ →</a>
  </section>
</BaseLayout>
