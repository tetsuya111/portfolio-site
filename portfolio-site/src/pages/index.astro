---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PortfolioTile from "../components/PortfolioTile.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PortfolioMockNote from "../components/PortfolioMockNote.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { siteConfig } from "../site.config";
import { formatDisplayDate, publishedArticles, sortPortfolios } from "../lib/content-query";

const profile = await getEntry("profile", "profile");
if (!profile) throw new Error("src/content/profile/profile.md がありません");
const portfolios = sortPortfolios(await getCollection("portfolios"));
const latestArticles = publishedArticles(await getCollection("articles")).slice(0, 3);
---

<BaseLayout title={siteConfig.name} description={profile.data.summary}>
  <section class="mb-16 rounded-card bg-linear-to-br from-hero-from to-hero-to px-6 py-12 sm:px-10 sm:py-16">
    <Eyebrow>Hello</Eyebrow>
    <h1 class="mt-3 font-heading text-4xl leading-tight font-bold tracking-tight break-words sm:text-5xl">
      {profile.data.name}
    </h1>
    <p class="mt-3 text-lg font-medium text-muted">{profile.data.role}</p>
    {profile.data.summary && <p class="mt-5 max-w-2xl leading-relaxed">{profile.data.summary}</p>}
    <a href="/about/" class="btn-accent mt-8 px-5 py-2.5 text-sm">経歴・自己紹介を見る →</a>
  </section>

  <section class="mb-16">
    <SectionHeading eyebrow="Works" title="ポートフォリオ" class="mb-2" />
    <PortfolioMockNote class="mb-6" />
    {
      portfolios.length === 0 ? (
        <p class="text-muted">まだありません。</p>
      ) : (
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {portfolios.map((p) => (
            <PortfolioTile slug={p.id} title={p.data.title} tags={p.data.tags} url={p.data.url} />
          ))}
        </div>
      )
    }
    <a href="/portfolios/" class="mt-6 inline-block text-sm font-semibold text-link hover:underline"
      >ポートフォリオ一覧へ →</a
    >
  </section>

  <section>
    <SectionHeading eyebrow="Articles" title="最新の記事" class="mb-6" />
    {
      latestArticles.length === 0 ? (
        <p class="text-muted">まだありません。</p>
      ) : (
        <ul class="divide-y divide-line overflow-hidden rounded-card border border-line bg-surface">
          {latestArticles.map((a) => (
            <li class="flex flex-col gap-1 px-5 py-4 sm:flex-row sm:items-baseline sm:gap-4">
              <time class="shrink-0 text-sm text-muted tabular-nums" datetime={a.data.date.toISOString()}>
                {formatDisplayDate(a.data.date)}
              </time>
              <a href={`/articles/${a.id}/`} class="font-medium hover:text-link hover:underline">
                {a.data.title}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <a href="/articles/" class="mt-6 inline-block text-sm font-semibold text-link hover:underline">記事一覧へ →</a>
  </section>
</BaseLayout>
