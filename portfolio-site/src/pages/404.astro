---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
---

<BaseLayout title="ページが見つかりません">
  <div class="py-10 text-center">
    <SectionHeading as="h1" eyebrow="404 Not Found" title="ページが見つかりません" class="items-center" />
    <p class="mt-8">
      <a
        href="/"
        class="inline-block rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-on-accent shadow-sm hover:opacity-90"
        >トップページへ戻る</a
      >
    </p>
  </div>
</BaseLayout>
