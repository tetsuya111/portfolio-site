---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagList from "../../components/TagList.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { formatDisplayDate, publishedArticles } from "../../lib/content-query";
import { getAllArticles } from "../../lib/articles";

const articles = publishedArticles(await getAllArticles());
---

<BaseLayout title="記事">
  <SectionHeading as="h1" eyebrow="Articles" title="記事" class="mb-8" />
  {articles.length === 0 && <p class="text-muted">まだありません。</p>}
  <ul class="space-y-5">
    {
      articles.map((a) => (
        <li class="rounded-card border border-line bg-surface p-5 shadow-sm">
          <time class="text-sm text-muted tabular-nums" datetime={a.data.date.toISOString()}>
            {formatDisplayDate(a.data.date)}
          </time>
          <h2 class="mt-1 font-heading text-lg font-bold">
            <a href={`/articles/${a.id}/`} class="hover:text-link hover:underline">
              {a.data.title}
            </a>
          </h2>
          {a.data.description && <p class="mt-1 text-muted">{a.data.description}</p>}
          <div class="mt-3">
            <TagList tags={a.data.tags} />
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>
