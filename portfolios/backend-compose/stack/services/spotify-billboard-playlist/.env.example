# Spotify Developer Dashboard で作成したアプリの値を設定する（このファイルをコピーして .env を作る）
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Dashboard の Redirect URIs にも同じ値を登録する（localhost は不可、127.0.0.1 を使う）
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
FRONTEND_URL=http://127.0.0.1:3000
# ポートフォリオサイトで公開するとき（サイトが https://portfolio.example.com の場合。README の「ポートフォリオサイトで公開する」を参照）
# FRONTEND_URL=https://portfolio.example.com/apps/spotify-billboard-playlist
# SPOTIFY_REDIRECT_URI=https://portfolio.example.com/apps/spotify-billboard-playlist/auth/callback
# FRONTEND_URL のパスの下に Cookie を発行する。SPOTIFY_REDIRECT_URI は FRONTEND_URL + /auth/callback にする（同じホストの <パス>/auth/ の下でなければ起動しない）
# FRONTEND_URL・SPOTIFY_REDIRECT_URI は https 必須（http はループバックのホストのみ可。違反すると起動しない）
# Cookie の Secure 属性（true / false）。未指定なら FRONTEND_URL が https のときだけ付ける。false はループバックのみ可
# COOKIE_SECURE=true
# DB_PATH=data/app.db
