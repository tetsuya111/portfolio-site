# このファイルを .env という名前でコピーし、値を設定してください（.env は Git 管理外です）。
# 取得・制限設定の手順は README.md の「APIキーの設定」を参照してください。

# Google Maps Platform の APIキー（Maps JavaScript API と Places API (New) を有効にしたもの）
VITE_GOOGLE_MAPS_API_KEY=

# 任意: Google Cloud で作成した Map ID。空なら Google のデモ用ID（DEMO_MAP_ID）を使います
VITE_GOOGLE_MAPS_MAP_ID=
