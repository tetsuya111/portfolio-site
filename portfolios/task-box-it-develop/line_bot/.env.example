# 各項目の説明は docs/line-bot.md を参照。コピーして .env を作成する（.env はコミットしない）

# LINE Messaging API（本番用と開発用でチャネルを分ける）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LIFFアプリのID。未設定のときはテキストのフォーマットで登録を案内する
LIFF_ID=

# 未設定なら開発用に line_bot/line_bot.sqlite3 を使う。本番は postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=1000
# 1ユーザーあたり1日のLLM呼び出し回数の上限
DAILY_LLM_CALL_LIMIT=30
# app.agents.llm.FakeLLMClient にすると、APIキーなしで決まった応答を返す
LLM_CLIENT_CLASS=app.agents.llm.AnthropicLLMClient

# 公開URL（インターネットからこのアプリに届くURL）
# USE_NGROK=true は開発用。別ターミナルで `ngrok http 8100` を起動しておくと、
# 起動時にその公開URLを読み、LINEのWebhookエンドポイントを自動で設定する。
# 本番では false のままにし、PUBLIC_BASE_URL にホスティング先のURLを入れる。
USE_NGROK=false
PUBLIC_BASE_URL=
# ngrokのローカルAPI。ポートを変えている場合だけ指定する
NGROK_API_URL=http://127.0.0.1:4040/api/tunnels
# トンネルが複数あるときに名前で選ぶ
NGROK_TUNNEL_NAME=
# production にすると、USE_NGROK が有効な場合に警告を出す
ENVIRONMENT=development

# 案内先。未設定なら「機能改修中」と返す
CONTRACT_PAGE_URL=
HEARING_SITE_URL=

# 保持期間（purge で使う）
HISTORY_RETENTION_HOURS=24
EVENT_RETENTION_HOURS=48
HISTORY_MAX_TURNS=10
