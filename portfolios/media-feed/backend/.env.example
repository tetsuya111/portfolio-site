# バックエンド・バッチが参照する環境変数のテンプレート。
# このファイルをコピーして backend/.env を作り、実際の値を記入する（.env はコミットしない）。
#   cp backend/.env.example backend/.env
#
# 読み込み方法は backend/readme.md を参照。

# --- Django ---
# 本番では必ずランダムな値を設定する。未設定の場合は settings.py の開発用の既定値が使われる。
DJANGO_SECRET_KEY=

# --- Django ---
# 開発機のみ True。本番では未設定のまま（既定 False）にする。
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=

# --- DMM (FANZA) Affiliate API: get_dmm_videos / get_dmm_images ---
DMM_API_ID=
DMM_AFFILIATE_ID=

# --- DUGA Affiliate: get_duga ---
DUGA_AFFILIATE_ID=

# --- AWS: メディアのS3保管・配信 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 既定リージョン。新規アップロード先と移行後の配信元。
AWS_REGION=ap-northeast-1

# --- メディア用S3バケット ---
# 新規アップロード先・配信元のバケット。
MEDIA_S3_BUCKET=
# 既定リージョン以外にあるバケットの対応表。"bucket=region,bucket2=region2" 形式。
# S3のリージョンは作成後に変更できないため、移行期間中は旧バケットのリージョンをここで教える。
MEDIA_BUCKET_REGIONS=
# sync_media_region のコピー先バケット（--dest-bucket 未指定時の既定値）。
MEDIA_S3_BUCKET_NEW=

# --- メディア配信方式 ---
# proxy: 従来どおりアプリが中継（既定、ローカル開発向け）
# s3   : S3 presigned URL を返し、ブラウザが直接S3から取得する（CloudFront不要）
# cdn  : CloudFront 署名付きURL（CLOUDFRONT_* の設定が必要）
MEDIA_DELIVERY_MODE=proxy
# 署名URLの有効期間（秒）。既定6時間。実際のURLは1時間境界に量子化される。
MEDIA_SIGNED_URL_TTL=21600
# メディアのキャッシュ有効期間（秒）。既定30日。
MEDIA_CACHE_MAX_AGE=2592000
# cdn モードで使う。
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=

# --- Cloudflare Turnstile: bot対策の検証 ---
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# --- 問い合わせフォームのメール送信 ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
# Gmailの場合はアプリパスワード。
EMAIL_HOST_PASSWORD=
# 問い合わせの通知先。未設定なら EMAIL_HOST_USER が使われる。
INQUIRY_RECIPIENT_EMAIL=

# --- OpenAI API: create_random_articles の文面生成のみ ---
OPENAI_API_KEY=
