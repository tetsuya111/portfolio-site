# Spotify Developer Dashboard で作成したアプリの値を設定する（このファイルをコピーして .env を作る）
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Dashboard の Redirect URIs にも同じ値を登録する（localhost は不可、127.0.0.1 を使う）
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
FRONTEND_URL=http://127.0.0.1:3000
# FRONTEND_URL・SPOTIFY_REDIRECT_URI は https 必須（http はループバックのホストのみ可。違反すると起動しない）
# Cookie の Secure 属性（true / false）。未指定なら FRONTEND_URL が https のときだけ付ける。false はループバックのみ可
# COOKIE_SECURE=true
# DB_PATH=data/app.db
