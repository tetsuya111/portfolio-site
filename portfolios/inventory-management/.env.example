# バックエンドの設定例。backend/.env にコピーして使う（.env はコミットしない）。
# development / production（production では JWT_SECRET の強度を起動時に確認する）
APP_ENV=development
DATABASE_URL=sqlite:///./inventory.db
# 本番では32文字以上のランダムな値にする（例: python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# フロントエンドのオリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:3000

# フロントエンド（frontend/.env.local）
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
