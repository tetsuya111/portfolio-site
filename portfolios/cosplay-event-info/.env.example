# バックエンド（Django）
APP_ENV=development                 # production にすると DEBUG 無効・DJANGO_SECRET_KEY が必須
DJANGO_SECRET_KEY=                  # 本番では十分に長いランダムな文字列を設定する
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_PATH=                      # SQLite ファイルの場所（既定: backend/cosplay.db）
CORS_ORIGINS=http://localhost:3000  # カンマ区切り
FETCH_MIN_INTERVAL=1.0              # 同じホストへのリクエスト間隔（秒）
ANTHROPIC_API_KEY=                  # 設定すると開催場所の正規化に Claude API を使う（任意）

# フロントエンド（Next.js、ビルド時に埋め込まれる）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
