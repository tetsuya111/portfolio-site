# backend/.env の例。このファイルを .env にコピーして値を入れる（.env はコミットしない）。
# シェルで設定した環境変数があれば、そちらが優先される。

# 会場の緯度経度の取得（Geocoding API だけに制限したキーを推奨）
GOOGLE_MAPS_GEOCODING_API_KEY=

# 開催場所の AI 補完（未設定なら規則ベースの正規化だけを行う）
ANTHROPIC_API_KEY=
# VENUE_NORMALIZER_MODEL=claude-opus-5-5

# 本番で使う場合（npm スクリプト経由のローカル実行では APP_ENV=development が補われる）
# APP_ENV=production
# DJANGO_SECRET_KEY=
# ALLOWED_HOSTS=example.com
# CORS_ORIGINS=https://example.com
