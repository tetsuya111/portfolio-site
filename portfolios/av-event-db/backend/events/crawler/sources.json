{
  "_comment": "取り込み対象サイトの抽出ルール。av-event は実サイトの HTML に合わせて調整済み。dmm-avevent・pls1 は未調査の仮置きなので、実際の HTML に合わせて調整する（README 参照）。",
  "sources": [
    {
      "name": "av-event",
      "list_urls": [
        "https://www.av-event.jp/top/",
        "https://www.av-event.jp/new_event/",
        "https://www.av-event.jp/search/?area_id=4"
      ],
      "mode": "detail",
      "detail_link_selector": "a[href*='/event/']",
      "fields": {
        "title": "h1.m-ttl-event_tx",
        "actresses": {
          "selector": ".p-event-info_detail-info--cast a.p-event-info_detail-info-anchor-btn",
          "multiple": true
        },
        "date": "section.p-event-info_held-info dl.p-event-info_held-info-list dt:-soup-contains('開催日時') + dd",
        "venue": "section.p-event-info_held-info dl.p-event-info_held-info-list dt:-soup-contains('会場情報') + dd",
        "address": "section.p-event-info_held-info dl.p-event-info_held-info-list dt:-soup-contains('住所') + dd",
        "summary": "section.p-event-info_considerations-area dt:-soup-contains('参加条件') + dd",
        "note": "section.p-event-info_considerations-area dl.p-event-info_considerations dd"
      }
    },
    {
      "name": "dmm-avevent",
      "list_urls": [
        "https://www.dmm.co.jp/live/chat/-/avevent/"
      ],
      "mode": "detail",
      "detail_link_selector": "a[href*='avevent'][href*='detail']",
      "cookies": {
        "age_check_done": "1"
      },
      "fields": {
        "title": "h1",
        "actresses": {
          "selector": ".actress a",
          "multiple": true
        },
        "date": ".date",
        "venue": ".place",
        "summary": ".summary",
        "note": ".note",
        "link": {
          "selector": "a.official",
          "attr": "href"
        }
      }
    },
    {
      "name": "pls1",
      "list_urls": [
        "https://pls1.jp/schedule/"
      ],
      "mode": "list",
      "item_selector": ".schedule-item, .schedule li",
      "fields": {
        "title": ".title",
        "actresses": {
          "selector": ".name",
          "multiple": true
        },
        "date": ".date",
        "venue": ".place",
        "summary": ".text",
        "link": {
          "selector": "a",
          "attr": "href"
        }
      }
    }
  ]
}
